pkgname=omacam-git
pkgver=0.1.0
pkgrel=1
pkgdesc='Omarchy-first Android webcam bridge'
arch=('x86_64')
url='https://github.com/anandxdj/omalens'
license=('MIT')
depends=('gst-plugins-base' 'gst-plugins-bad' 'gst-plugins-good' 'v4l-utils')
optdepends=('v4l2loopback-dkms: dedicated virtual camera output device')
makedepends=('cargo' 'rust')
options=('!lto')
source=()
sha256sums=()

build() {
  cd "$startdir/../.."
  cargo build --release --locked --workspace
}

package() {
  cd "$startdir/../.."
  install -Dm755 target/release/omacam-daemon "$pkgdir/usr/bin/omacam-daemon"
  install -Dm755 target/release/omacam-output "$pkgdir/usr/bin/omacam-output"
  install -Dm755 target/release/omacam-preview "$pkgdir/usr/bin/omacam-preview"
  install -Dm644 packaging/systemd/omacam.service "$pkgdir/usr/lib/systemd/user/omacam.service"
  install -Dm644 packaging/systemd/service.conf.example "$pkgdir/usr/share/doc/omacam/service.conf.example"
  install -Dm644 packaging/README.md "$pkgdir/usr/share/doc/omacam/packaging.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -d "$pkgdir/usr/share/omacam/omarchy-plugin"
  cp -a omarchy-plugin/. "$pkgdir/usr/share/omacam/omarchy-plugin/"
}

# Deliberately no install script and no automatic enable/start. V4L2 provisioning,
# firewall changes, and shell activation require separate explicit user action.
